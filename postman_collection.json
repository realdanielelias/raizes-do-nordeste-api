{
  "info": {
    "name": "Raízes do Nordeste - Coleção de Testes Oficiais (10 Cenários)",
    "description": "Suíte de validação da API cobrindo 6 cenários positivos e 4 cenários negativos conforme edital da UNINTER.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "tokenCliente", "value": "" },
    { "key": "tokenAtendente", "value": "" }
  ],
  "item": [
    {
      "name": "T01 - [Positivo] Login com Credenciais Válidas",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cliente@raizes.com\",\n  \"senha\": \"SenhaValida123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
      }
    },
    {
      "name": "T02 - [Positivo] Consultar Cardápio por Unidade",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/produtos?unidadeId=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "produtos"],
          "query": [{ "key": "unidadeId", "value": "1" }]
        }
      }
    },
    {
      "name": "T03 - [Positivo] Criar Pedido via TOTEM com Estoque",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"TOTEM\",\n  \"formaPagamento\": \"PIX\",\n  \"itens\": [\n    { \"produtoId\": 1, \"quantidade\": 1 }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pedidos"] }
      }
    },
    {
      "name": "T04 - [Positivo] Criar Pedido via APP com canalPedido",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"APP\",\n  \"formaPagamento\": \"CARTAO_CREDITO\",\n  \"itens\": [\n    { \"produtoId\": 2, \"quantidade\": 2 }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pedidos"] }
      }
    },
    {
      "name": "T05 - [Positivo] Pagamento Mock Aprovado",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pedidoId\": 1,\n  \"metodo\": \"PIX\",\n  \"simularAprovacao\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/pagamentos/mock", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pagamentos", "mock"] }
      }
    },
    {
      "name": "T06 - [Positivo] Atualizar Status para PRONTO (Cozinha)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAtendente}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"novoStatus\": \"PRONTO\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/pedidos/1/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pedidos", "1", "status"] }
      }
    },
    {
      "name": "T07 - [Negativo] Acesso Sem Token (401 Unauthorized)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/v1/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pedidos"] }
      }
    },
    {
      "name": "T08 - [Negativo] CLIENTE em Rota Restrita de Gerente (403 Forbidden)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unidadeId\": 1,\n  \"produtoId\": 1,\n  \"novaQuantidade\": 50\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/unidades/estoque/ajuste", "host": ["{{baseUrl}}"], "path": ["api", "v1", "unidades", "estoque", "ajuste"] }
      }
    },
    {
      "name": "T09 - [Negativo] Pedido com Canal Inválido (422 Unprocessable Entity)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"CANAL_INEXISTENTE\",\n  \"formaPagamento\": \"PIX\",\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 1 }]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pedidos"] }
      }
    },
    {
      "name": "T10 - [Negativo] Pedido com Estoque Insuficiente (409 Conflict)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"TOTEM\",\n  \"formaPagamento\": \"PIX\",\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 9999 }]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/pedidos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pedidos"] }
      }
    }
  ]
}